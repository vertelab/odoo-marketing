<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Pre-configured marketing AI agents -->
    <record id="marketing_agent_content_strategist" model="ai.agent">
        <field name="name">Content Strategist</field>
        <field name="ai_type">marketing</field>
        <field name="ai_role">Content Strategy Expert</field>
        <field name="ai_goal">Create data-driven content strategies from Odoo CRM and sales data</field>
        <field name="ai_backstory">Expert content strategist who analyzes customer data to create effective content plans</field>
        <field name="status">active</field>
    </record>

    <record id="marketing_agent_seo_specialist" model="ai.agent">
        <field name="name">SEO Specialist</field>
        <field name="ai_type">marketing</field>
        <field name="ai_role">SEO Expert</field>
        <field name="ai_goal">Optimize web presence using SEO audits and programmatic content</field>
        <field name="status">active</field>
    </record>

    <record id="marketing_agent_ads_manager" model="ai.agent">
        <field name="name">Ads Manager</field>
        <field name="ai_type">marketing</field>
        <field name="ai_role">Paid Advertising Expert</field>
        <field name="ai_goal">Optimize ad campaigns and creative performance</field>
        <field name="status">active</field>
    </record>

    <record id="marketing_agent_analyst" model="ai.agent">
        <field name="name">Marketing Analyst</field>
        <field name="ai_type">marketing</field>
        <field name="ai_role">Marketing Data Analyst</field>
        <field name="ai_goal">Analyze marketing performance and competitor activity</field>
        <field name="status">active</field>
    </record>

    <record id="marketing_agent_planner" model="ai.agent">
        <field name="name">Marketing Planner</field>
        <field name="ai_type">marketing</field>
        <field name="ai_role">Strategic Marketing Planner</field>
        <field name="ai_goal">Create comprehensive AARRR marketing plans from business data</field>
        <field name="status">active</field>
    </record>

    <!-- Tool assignments for each agent -->
    <record id="marketing_agent_tool_planner_content" model="ai.agent.tool">
        <field name="ai_agent_id" ref="marketing_agent_planner"/>
        <field name="name">Content Strategy</field>
        <field name="sequence">1</field>
    </record>

    <record id="marketing_agent_tool_planner_seo" model="ai.agent.tool">
        <field name="ai_agent_id" ref="marketing_agent_planner"/>
        <field name="name">SEO Audit</field>
        <field name="sequence">2</field>
    </record>
</odoo>
