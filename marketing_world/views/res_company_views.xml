<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_res_company_world_monitor_form" model="ir.ui.view">
        <field name="name">res.company.world.monitor.form</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="World Monitor" name="world_monitor">
                    <group>
                        <group>
                            <field name="world_monitor_enabled"/>
                            <field name="world_monitor_auto_brief"
                                   invisible="not world_monitor_enabled"/>
                            <field name="world_monitor_alert_on_critical"
                                   invisible="not world_monitor_enabled"/>
                        </group>
                        <group>
                            <field name="world_monitor_filter_industry"
                                   invisible="not world_monitor_enabled"/>
                            <field name="world_monitor_filter_countries"
                                   widget="many2many_tags"
                                   invisible="not world_monitor_enabled"/>
                        </group>
                    </group>
                </page>
            </notebook>
        </field>
    </record>
</odoo>
