<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Add Triage button to event tree/kanban -->
    <record id="view_world_event_triage_action" model="ir.actions.server">
        <field name="name">Triage Selected Events</field>
        <field name="model_id" ref="model_marketing_world_event"/>
        <field name="binding_model_id" ref="model_marketing_world_event"/>
        <field name="binding_view_types">list,kanban</field>
        <field name="state">code</field>
        <field name="code"><![CDATA[
action = env['ir.actions.act_window']._for_xml_id(
    'marketing_world.action_world_triage_wizard'
)
        ]]></field>
    </record>

    <!-- Add batch archive action -->
    <record id="view_world_event_batch_archive" model="ir.actions.server">
        <field name="name">Archive Selected Events</field>
        <field name="model_id" ref="model_marketing_world_event"/>
        <field name="binding_model_id" ref="model_marketing_world_event"/>
        <field name="binding_view_types">list,kanban</field>
        <field name="state">code</field>
        <field name="code"><![CDATA[
record_ids = env.context.get('active_ids', [])
if record_ids:
    events = env['marketing.world.event'].browse(record_ids)
    events.action_archive()
        ]]></field>
    </record>
</odoo>
