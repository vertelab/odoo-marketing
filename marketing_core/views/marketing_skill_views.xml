<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_skill_tree" model="ir.ui.view">
        <field name="name">marketing.skill.tree</field>
        <field name="model">marketing.skill</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="category"/>
                <field name="version"/>
                <field name="is_base"/>
                <field name="is_active"/>
                <field name="module_origin"/>
            </list>
        </field>
    </record>

    <record id="view_skill_form" model="ir.ui.view">
        <field name="name">marketing.skill.form</field>
        <field name="model">marketing.skill</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="category"/>
                        <field name="version"/>
                    </group>
                    <group>
                        <field name="is_active"/>
                        <field name="is_base"/>
                        <field name="module_origin"/>
                    </group>
                    <notebook>
                        <page string="Skill Content" name="content">
                            <field name="skill_content_html" widget="html"/>
                        </page>
                        <page string="Raw" name="raw">
                            <field name="skill_content"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_skill_search" model="ir.ui.view">
        <field name="name">marketing.skill.search</field>
        <field name="model">marketing.skill</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="description"/>
                <filter name="active" string="Active" domain="[('is_active','=',True)]"/>
                <group expand="0" string="Group By">
                    <filter name="by_category" string="Category" domain="[]"
                            context="{'group_by':'category'}"/>
                    <filter name="by_origin" string="Module" domain="[]"
                            context="{'group_by':'module_origin'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_marketing_skill" model="ir.actions.act_window">
        <field name="name">Marketing Skills</field>
        <field name="res_model">marketing.skill</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
