<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_context_form" model="ir.ui.view">
        <field name="name">marketing.context.form</field>
        <field name="model">marketing.context</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group><field name="customer_id"/></group>
                    <notebook>
                        <page string="Product"><field name="product_context" widget="html"/></page>
                        <page string="ICP"><field name="icp" widget="html"/></page>
                        <page string="Brand Voice"><field name="brand_voice" widget="html"/></page>
                        <page string="Positioning"><field name="positioning" widget="html"/></page>
                        <page string="KPIs"><field name="current_kpis" widget="html"/></page>
                        <page string="Channels"><field name="active_channels" widget="html"/></page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_idea_tree" model="ir.ui.view">
        <field name="name">marketing.idea.tree</field>
        <field name="model">marketing.idea</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="aarrr_stage"/>
                <field name="difficulty"/>
                <field name="impact"/>
                <field name="is_used"/>
            </list>
        </field>
    </record>

    <record id="view_kpi_tree" model="ir.ui.view">
        <field name="name">marketing.kpi.tree</field>
        <field name="model">marketing.kpi</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="category"/>
                <field name="unit"/>
                <field name="target_value"/>
                <field name="current_value"/>
            </list>
        </field>
    </record>

    <record id="action_marketing_context" model="ir.actions.act_window">
        <field name="name">Marketing Context</field>
        <field name="res_model">marketing.context</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_marketing_idea" model="ir.actions.act_window">
        <field name="name">Ideas</field>
        <field name="res_model">marketing.idea</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_marketing_kpi" model="ir.actions.act_window">
        <field name="name">KPIs</field>
        <field name="res_model">marketing.kpi</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
