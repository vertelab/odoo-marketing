<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_marketing_admin" model="res.groups">
        <field name="name">Marketing Admin</field>
        <field name="category_id" ref="base.module_category_hidden"/>
        <field name="implied_ids" eval="[(4, ref('marketing_core.group_marketing_manager')),
                                           (4, ref('marketing_core.group_marketing_pi_agent')),
                                           (4, ref('marketing_core.group_marketing_user'))]"/>
    </record>

    <record id="group_marketing_manager" model="res.groups">
        <field name="name">Marketing Manager</field>
        <field name="category_id" ref="base.module_category_hidden"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user')),
                                           (4, ref('marketing_core.group_marketing_user'))]"/>
    </record>

    <record id="group_marketing_pi_agent" model="res.groups">
        <field name="name">Marketing Pi Agent</field>
        <field name="category_id" ref="base.module_category_hidden"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_marketing_user" model="res.groups">
        <field name="name">Marketing User</field>
        <field name="category_id" ref="base.module_category_hidden"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- System administrators automatically become Marketing Admin -->
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('marketing_core.group_marketing_admin'))]"/>
    </record>
</odoo>
